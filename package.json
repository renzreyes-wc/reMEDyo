{
  "name": "remedyo",
  "version": "0.1.0",
  "private": true,
  "description": "reMEDyo - telehealth prototype",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --filter shared build && pnpm --filter api build && pnpm --filter web build",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter api prisma migrate dev",
    "db:push": "pnpm --filter api prisma db push",
    "db:seed": "pnpm --filter api seed",
    "db:studio": "pnpm --filter api prisma studio",
    "test": "pnpm --filter api test"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.5.1"
}
